@page "/acreditacion"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<PageTitle>Gestión de Acreditaciones</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Acreditaciones</h3>

    @* ───────── ALERTA ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTONES Y FILTROS ───────── *@
    <div class="row mb-3">
        <div class="col-md-6">
            @if (!mostrarFormulario)
            {
                <button class="btn btn-primary" @onclick="NuevoRegistro">Nueva Acreditación</button>
            }
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <label class="form-label me-2 mb-0">Límite:</label>
            <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
            <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
        </div>
    </div>

    @* ───────── FORMULARIO ADAPTADO (image_e24953.png) ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-4 border-success">
            <div class="card-header bg-success text-white">
                @(editando ? "Editar Acreditación" : "Nueva Acreditación")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Resolución (ID)</label>
                        <input class="form-control" type="number" @bind="campoResolucion" disabled="@editando" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Tipo</label>
                        <input class="form-control" @bind="campoTipo" placeholder="Ej: Alta Calidad" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">Calificación</label>
                        <input class="form-control" @bind="campoCalificacion" placeholder="Puntaje o nivel" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Inicio</label>
                        <input class="form-control" @bind="campoFechaInicio" placeholder="AAAA-MM-DD" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Fin</label>
                        <input class="form-control" @bind="campoFechaFin" placeholder="AAAA-MM-DD" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Programa Académico</label>
                        <select class="form-select" @bind="campoPrograma">
                            <option value="0">-- Seleccione Programa --</option>
                            @foreach (var p in programas)
                            {
                                <option value="@p["id"]">@p["nombre"]</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-2 text-end">
                    <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @* ───────── TABLA DE DATOS ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (registros.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Resolución</th>
                        <th>Tipo</th>
                        <th>Calificación</th>
                        <th>Vigencia</th>
                        <th>Programa</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@reg["resolucion"]</td>
                            <td>@reg["tipo"]</td>
                            <td>@reg["calificacion"]</td>
                            <td><small>@reg["fecha_inicio"] a @reg["fecha_fin"]</small></td>
                            <td>@ObtenerNombrePrograma(reg["programa"]?.ToString())</td>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => EditarRegistro(reg)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay acreditaciones registradas.</div>
    }
</div>

@code {
    [Microsoft.AspNetCore.Components.Inject]
    private ApiService Api { get; set; } = default!;

    [Microsoft.AspNetCore.Components.Inject]
    private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> programas = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos de la tabla acreditacion
    private int campoResolucion = 0;
    private string campoTipo = "";
    private string campoCalificacion = "";
    private string campoFechaInicio = "";
    private string campoFechaFin = "";
    private int campoPrograma = 0;
    private int? limite = null;

    protected override async Task OnInitializedAsync()
    {
        try {
            programas = await Api.ListarAsync("programa");
            await CargarRegistros();
        } catch (Exception ex) {
            mensaje = "Error: " + ex.Message;
            cargando = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("acreditacion", limite);
        cargando = false;
    }

    private string ObtenerNombrePrograma(string? id)
    {
        var prog = programas.FirstOrDefault(p => p["id"]?.ToString() == id);
        return prog?["nombre"]?.ToString() ?? $"ID: {id}";
    }

    private void NuevoRegistro()
    {
        editando = false;
        LimpiarCampos();
        mostrarFormulario = true;
    }

    private void LimpiarCampos()
    {
        campoResolucion = 0; campoTipo = ""; campoCalificacion = ""; 
        campoFechaInicio = ""; campoFechaFin = ""; campoPrograma = 0; mensaje = "";
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoResolucion = int.Parse(reg["resolucion"]?.ToString() ?? "0");
        campoTipo = reg["tipo"]?.ToString() ?? "";
        campoCalificacion = reg["calificacion"]?.ToString() ?? "";
        campoFechaInicio = reg["fecha_inicio"]?.ToString() ?? "";
        campoFechaFin = reg["fecha_fin"]?.ToString() ?? "";
        campoPrograma = int.Parse(reg["programa"]?.ToString() ?? "0");
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?> {
            ["resolucion"] = campoResolucion,
            ["tipo"] = campoTipo,
            ["calificacion"] = campoCalificacion,
            ["fecha_inicio"] = campoFechaInicio,
            ["fecha_fin"] = campoFechaFin,
            ["programa"] = campoPrograma
        };

        // Se usa "resolucion" como PK para la API
        var res = editando 
            ? await Api.ActualizarAsync("acreditacion", "resolucion", campoResolucion.ToString(), datos)
            : await Api.CrearAsync("acreditacion", datos);

        exito = res.exito;
        mensaje = res.mensaje;
        if (exito) { mostrarFormulario = false; await CargarRegistros(); }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar resolución {reg["resolucion"]}?")) {
            var res = await Api.EliminarAsync("acreditacion", "resolucion", reg["resolucion"]?.ToString() ?? "");
            exito = res.exito;
            mensaje = res.mensaje;
            if (exito) await CargarRegistros();
        }
    }

    private void Cancelar() { mostrarFormulario = false; mensaje = ""; }
}