@page "/pasantia"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<PageTitle>Gestión de Pasantías</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Pasantías</h3>

    @* ───────── ALERTA ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTONES Y FILTROS ───────── *@
    <div class="row mb-3">
        <div class="col-md-6">
            @if (!mostrarFormulario)
            {
                <button class="btn btn-primary" @onclick="NuevoRegistro">Nueva Pasantía</button>
            }
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <label class="form-label me-2 mb-0">Límite:</label>
            <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
            <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
        </div>
    </div>

    @* ───────── FORMULARIO ADAPTADO (image_d7ca5d.png) ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                @(editando ? "Editar Pasantía" : "Nueva Pasantía")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label">ID</label>
                        <input class="form-control" type="number" @bind="campoId" disabled="@editando" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="campoNombre" placeholder="Nombre de la pasantía" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">País</label>
                        <input class="form-control" @bind="campoPais" placeholder="País destino" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Empresa</label>
                        <input class="form-control" @bind="campoEmpresa" placeholder="Empresa aliada" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Programa Académico</label>
                        <select class="form-select" @bind="campoPrograma">
                            <option value="0">-- Seleccione Programa --</option>
                            @foreach (var p in programas)
                            {
                                <option value="@p["id"]">@p["nombre"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="2" @bind="campoDescripcion"></textarea>
                    </div>
                </div>
                <div class="mt-2 text-end">
                    <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @* ───────── TABLA DE DATOS ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (registros.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>País</th>
                        <th>Empresa</th>
                        <th>Programa</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@reg["id"]</td>
                            <td>@reg["nombre"]</td>
                            <td>@reg["pais"]</td>
                            <td>@reg["empresa"]</td>
                            <td>@ObtenerNombrePrograma(reg["programa"]?.ToString())</td>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => EditarRegistro(reg)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay pasantías registradas.</div>
    }
</div>

@code {
    [Microsoft.AspNetCore.Components.Inject]
    private ApiService Api { get; set; } = default!;

    [Microsoft.AspNetCore.Components.Inject]
    private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> programas = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos de la tabla pasantia
    private int campoId = 0;
    private string campoNombre = "";
    private string campoPais = "";
    private string campoEmpresa = "";
    private string campoDescripcion = "";
    private int campoPrograma = 0;
    private int? limite = null;

    protected override async Task OnInitializedAsync()
    {
        try {
            programas = await Api.ListarAsync("programa");
            await CargarRegistros();
        } catch (Exception ex) {
            mensaje = "Error: " + ex.Message;
            cargando = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("pasantia", limite);
        cargando = false;
    }

    private string ObtenerNombrePrograma(string? id)
    {
        var prog = programas.FirstOrDefault(p => p["id"]?.ToString() == id);
        return prog?["nombre"]?.ToString() ?? $"ID: {id}";
    }

    private void NuevoRegistro()
    {
        editando = false;
        LimpiarCampos();
        mostrarFormulario = true;
    }

    private void LimpiarCampos()
    {
        campoId = 0; campoNombre = ""; campoPais = ""; campoEmpresa = "";
        campoDescripcion = ""; campoPrograma = 0; mensaje = "";
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoId = int.Parse(reg["id"]?.ToString() ?? "0");
        campoNombre = reg["nombre"]?.ToString() ?? "";
        campoPais = reg["pais"]?.ToString() ?? "";
        campoEmpresa = reg["empresa"]?.ToString() ?? "";
        campoDescripcion = reg["descripcion"]?.ToString() ?? "";
        campoPrograma = int.Parse(reg["programa"]?.ToString() ?? "0");
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?> {
            ["id"] = campoId,
            ["nombre"] = campoNombre,
            ["pais"] = campoPais,
            ["empresa"] = campoEmpresa,
            ["descripcion"] = campoDescripcion,
            ["programa"] = campoPrograma
        };

        var res = editando 
            ? await Api.ActualizarAsync("pasantia", "id", campoId.ToString(), datos)
            : await Api.CrearAsync("pasantia", datos);

        exito = res.exito;
        mensaje = res.mensaje;
        if (exito) { mostrarFormulario = false; await CargarRegistros(); }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar pasantía {reg["nombre"]}?")) {
            var res = await Api.EliminarAsync("pasantia", "id", reg["id"]?.ToString() ?? "");
            exito = res.exito;
            mensaje = res.mensaje;
            if (exito) await CargarRegistros();
        }
    }

    private void Cancelar() { mostrarFormulario = false; mensaje = ""; }
}