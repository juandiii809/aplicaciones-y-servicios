@page "/programa"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<PageTitle>Programas Académicos</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Programas</h3>

    @* ───────── ALERTA ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTONES Y FILTROS ───────── *@
    <div class="row mb-3">
        <div class="col-md-6">
            @if (!mostrarFormulario)
            {
                <button class="btn btn-primary" @onclick="NuevoRegistro">Nuevo Programa</button>
            }
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <label class="form-label me-2 mb-0">Límite:</label>
            <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
            <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
        </div>
    </div>

    @* ───────── FORMULARIO COMPLETO ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                @(editando ? "Editar Programa" : "Nuevo Programa")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">ID</label>
                        <input class="form-control" type="number" @bind="campoId" disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre del Programa</label>
                        <input class="form-control" @bind="campoNombre" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Tipo</label>
                        <input class="form-control" @bind="campoTipo" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Nivel</label>
                        <input class="form-control" @bind="campoNivel" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ciudad</label>
                        <input class="form-control" @bind="campoCiudad" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Facultad</label>
                        <select class="form-select" @bind="campoFacultad">
                            <option value="0">-- Seleccione Facultad --</option>
                            @foreach (var f in facultades)
                            {
                                <option value="@f["id"]">@f["nombre"]</option>
                            }
                        </select>
                    </div>

                    @* Campos adicionales según image_c7d1c4.png *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Fecha Creación</label>
                        <input class="form-control" @bind="campoFechaCreacion" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Fecha Cierre</label>
                        <input class="form-control" @bind="campoFechaCierre" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Última Actualización</label>
                        <input class="form-control" @bind="campoFechaActualizacion" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Número de Cohortes</label>
                        <input class="form-control" @bind="campoNumCohortes" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cant. Graduados</label>
                        <input class="form-control" @bind="campoCantGraduados" />
                    </div>
                </div>
                <div class="mt-2 text-end">
                    <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar Programa</button>
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @* ───────── TABLA ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (registros.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Nivel</th>
                        <th>Ciudad</th>
                        <th>Facultad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@reg["id"]</td>
                            <td><strong>@reg["nombre"]</strong></td>
                            <td>@reg["nivel"]</td>
                            <td>@reg["ciudad"]</td>
                            <td>@ObtenerNombreFacultad(reg["facultad"]?.ToString())</td>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => EditarRegistro(reg)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Microsoft.AspNetCore.Components.Inject]
    private ApiService Api { get; set; } = default!;

    [Microsoft.AspNetCore.Components.Inject]
    private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> facultades = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Todos los campos de la tabla programa
    private int campoId = 0;
    private string campoNombre = "";
    private string campoTipo = "";
    private string campoNivel = "";
    private string campoFechaCreacion = "";
    private string campoFechaCierre = "";
    private string campoNumCohortes = "";
    private string campoCantGraduados = "";
    private string campoFechaActualizacion = "";
    private string campoCiudad = "";
    private int campoFacultad = 0;
    private int? limite = null;

    protected override async Task OnInitializedAsync()
    {
        try {
            facultades = await Api.ListarAsync("facultad");
            await CargarRegistros();
        } catch (Exception ex) {
            mensaje = "Error: " + ex.Message;
            cargando = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("programa", limite);
        cargando = false;
    }

    private string ObtenerNombreFacultad(string? id)
    {
        var fac = facultades.FirstOrDefault(f => f["id"]?.ToString() == id);
        return fac?["nombre"]?.ToString() ?? $"ID: {id}";
    }

    private void NuevoRegistro()
    {
        editando = false;
        LimpiarCampos();
        mostrarFormulario = true;
    }

    private void LimpiarCampos()
    {
        campoId = 0; campoNombre = ""; campoTipo = ""; campoNivel = "";
        campoFechaCreacion = ""; campoFechaCierre = ""; campoNumCohortes = "";
        campoCantGraduados = ""; campoFechaActualizacion = ""; campoCiudad = "";
        campoFacultad = 0; mensaje = "";
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoId = int.Parse(reg["id"]?.ToString() ?? "0");
        campoNombre = reg["nombre"]?.ToString() ?? "";
        campoTipo = reg["tipo"]?.ToString() ?? "";
        campoNivel = reg["nivel"]?.ToString() ?? "";
        campoFechaCreacion = reg["fecha_creacion"]?.ToString() ?? "";
        campoFechaCierre = reg["fecha_cierre"]?.ToString() ?? "";
        campoNumCohortes = reg["numero_cohortes"]?.ToString() ?? "";
        campoCantGraduados = reg["cant_graduados"]?.ToString() ?? "";
        campoFechaActualizacion = reg["fecha_actualizacion"]?.ToString() ?? "";
        campoCiudad = reg["ciudad"]?.ToString() ?? "";
        campoFacultad = int.Parse(reg["facultad"]?.ToString() ?? "0");
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?> {
            ["id"] = campoId,
            ["nombre"] = campoNombre,
            ["tipo"] = campoTipo,
            ["nivel"] = campoNivel,
            ["fecha_creacion"] = campoFechaCreacion,
            ["fecha_cierre"] = campoFechaCierre,
            ["numero_cohortes"] = campoNumCohortes,
            ["cant_graduados"] = campoCantGraduados,
            ["fecha_actualizacion"] = campoFechaActualizacion,
            ["ciudad"] = campoCiudad,
            ["facultad"] = campoFacultad
        };

        var res = editando 
            ? await Api.ActualizarAsync("programa", "id", campoId.ToString(), datos)
            : await Api.CrearAsync("programa", datos);

        exito = res.exito;
        mensaje = res.mensaje;
        if (exito) { mostrarFormulario = false; await CargarRegistros(); }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar {reg["nombre"]}?")) {
            var res = await Api.EliminarAsync("programa", "id", reg["id"]?.ToString() ?? "");
            exito = res.exito;
            mensaje = res.mensaje;
            if (exito) await CargarRegistros();
        }
    }

    private void Cancelar() { mostrarFormulario = false; mensaje = ""; }
}