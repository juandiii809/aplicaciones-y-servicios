@page "/alianza"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<PageTitle>Alianza</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Gestión de Alianzas</h3>
        @if (!mostrarFormulario)
        {
            <button class="btn btn-primary shadow" @onclick="NuevoRegistro">
                <i class="bi bi-plus-circle"></i> Nueva Alianza
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (mostrarFormulario)
    {
        <div class="card shadow border-primary mb-5">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@(editando ? "Editar Alianza" : "Nueva Alianza")</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Aliado (NIT)</label>
                        <select class="form-select" @bind="campoAliado" disabled="@editando">
                            <option value="">-- Seleccione un aliado --</option>
                            @foreach (var a in aliados)
                            {
                                <option value="@a["nit"]">@a["razon_social"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">ID Departamento</label>
                        <input class="form-control" type="number"
                               placeholder="Ingrese el ID del departamento"
                               @bind="campoDepartamento"
                               disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">ID Docente</label>
                        <input class="form-control" type="number"
                               placeholder="Ingrese el ID del docente"
                               @bind="campoDocente"
                               disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Fecha Inicio</label>
                        <input class="form-control" type="date" @bind="campoFechaInicio" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Fecha Fin</label>
                        <input class="form-control" type="date" @bind="campoFechaFin" />
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <button class="btn btn-success px-4 me-2" @onclick="GuardarRegistro">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (registros.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>Aliado</th>
                        <th>Departamento</th>
                        <th>Docente</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@ObtenerNombreAliado(reg["aliado"]?.ToString())</td>
                            <td>@reg["departamento"]</td>
                            <td>@reg["docente"]</td>
                            <td>@reg["fecha_inicio"]</td>
                            <td>@reg["fecha_fin"]</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1"
                                        @onclick="() => EditarRegistro(reg)">
                                    Editar
                                </button>
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => EliminarRegistro(reg)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No hay alianzas registradas.</div>
    }
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> aliados = new();

    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private bool exito = false;
    private string mensaje = "";

    private string campoAliado = "";
    private int campoDepartamento = 0;
    private int campoDocente = 0;
    private DateTime campoFechaInicio = DateTime.Now;
    private DateTime campoFechaFin = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarRegistros(), CargarAliados());
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("alianza");
        cargando = false;
    }

    private async Task CargarAliados()
    {
        aliados = await Api.ListarAsync("aliado");
    }

    private string ObtenerNombreAliado(string? nit)
    {
        if (string.IsNullOrEmpty(nit)) return "";
        var a = aliados.FirstOrDefault(x => x["nit"]?.ToString() == nit);
        return a?["razon_social"]?.ToString() ?? nit;
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoAliado = "";
        campoDepartamento = 0;
        campoDocente = 0;
        campoFechaInicio = DateTime.Now;
        campoFechaFin = DateTime.Now;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoAliado = reg["aliado"]?.ToString() ?? "";
        campoDepartamento = Convert.ToInt32(reg["departamento"]);
        campoDocente = Convert.ToInt32(reg["docente"]);
        if (DateTime.TryParse(reg["fecha_inicio"]?.ToString(), out var fi)) campoFechaInicio = fi;
        if (DateTime.TryParse(reg["fecha_fin"]?.ToString(), out var ff)) campoFechaFin = ff;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        if (string.IsNullOrEmpty(campoAliado))
        {
            mensaje = "Debe seleccionar un aliado.";
            exito = false;
            return;
        }

        if (campoDepartamento == 0)
        {
            mensaje = "Debe ingresar el ID del departamento.";
            exito = false;
            return;
        }

        if (campoDocente == 0)
        {
            mensaje = "Debe ingresar el ID del docente.";
            exito = false;
            return;
        }

        var datos = new Dictionary<string, object?>
        {
            ["aliado"]        = campoAliado,
            ["departamento"]  = campoDepartamento,
            ["docente"]       = campoDocente,
            ["fecha_inicio"]  = campoFechaInicio.ToString("yyyy-MM-dd"),
            ["fecha_fin"]     = campoFechaFin.ToString("yyyy-MM-dd")
        };

        try
        {
            if (editando)
            {
                datos.Remove("aliado");
                datos.Remove("departamento");
                datos.Remove("docente");
                var resultado = await Api.ActualizarAsync("alianza", "aliado", campoAliado, datos);
                exito = resultado.exito;
                mensaje = resultado.mensaje;
            }
            else
            {
                var resultado = await Api.CrearAsync("alianza", datos);
                exito = resultado.exito;
                mensaje = resultado.mensaje;
            }

            if (exito)
            {
                mostrarFormulario = false;
                await CargarRegistros();
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
            exito = false;
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        if (await JS.InvokeAsync<bool>("confirm", "¿Eliminar esta alianza?"))
        {
            var resultado = await Api.EliminarAsync("alianza", "aliado", reg["aliado"]?.ToString() ?? "");
            exito = resultado.exito;
            mensaje = resultado.mensaje;

            if (exito)
                await CargarRegistros();
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}