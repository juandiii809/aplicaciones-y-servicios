@page "/programa"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Gestión de Programas Académicos</h3>
        @if (!mostrarFormulario) {
            <button class="btn btn-primary shadow" @onclick="NuevoRegistro">
                <i class="bi bi-plus-circle"></i> Nuevo Programa
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(mensaje)) {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (mostrarFormulario) {
        <div class="card shadow border-primary mb-5">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@(editando ? "Editando Programa ID: " + campoId : "Nuevo Programa")</h5>
            </div>
            <div class="card-body">
                @* --- CAMPOS PROGRAMA --- *@
                <div class="row border-bottom pb-3 mb-4">
                    <div class="col-md-2 mb-3">
                        <label class="fw-bold">ID (PK)</label>
                        <input class="form-control" type="number" @bind="campoId" disabled="@editando" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="fw-bold">Nombre</label>
                        <input class="form-control" @bind="campoNombre" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="fw-bold">Facultad (Número)</label>
                        <input type="number" class="form-control" @bind="campoFacultad" />
                    </div>

                    <div class="col-md-3 mb-2"><label class="small fw-bold">Tipo</label><input class="form-control" @bind="campoTipo" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">Nivel</label><input class="form-control" @bind="campoNivel" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">Ciudad</label><input class="form-control" @bind="campoCiudad" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">N° Cohortes</label><input class="form-control" @bind="campoNumCohortes" /></div>

                    <div class="col-md-3 mb-2"><label class="small fw-bold">Fecha Creación</label><input class="form-control" type="date" @bind="campoFechaCreacion" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">Fecha Cierre</label><input class="form-control" type="date" @bind="campoFechaCierre" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">Cant. Graduados</label><input class="form-control" @bind="campoCantGraduados" /></div>
                    <div class="col-md-3 mb-2"><label class="small fw-bold">Última Actualización</label><input class="form-control" type="date" @bind="campoFechaActualizacion" /></div>
                </div>

                @* --- DETALLE DE PASANTÍAS --- *@
                <h5 class="text-secondary mb-3">Detalle de Pasantías</h5>
                <div class="bg-light p-3 border rounded mb-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-3"><input class="form-control" placeholder="Nombre" @bind="tmpPasNombre" /></div>
                        <div class="col-md-2"><input class="form-control" placeholder="País" @bind="tmpPasPais" /></div>
                        <div class="col-md-2"><input class="form-control" placeholder="Empresa" @bind="tmpPasEmpresa" /></div>
                        <div class="col-md-4"><input class="form-control" placeholder="Descripción" @bind="tmpPasDesc" /></div>
                        <div class="col-md-1"><button type="button" class="btn btn-info w-100" @onclick="AgregarPasLocal">+</button></div>
                    </div>

                    <table class="table table-sm table-hover bg-white border">
                        <thead>
                            <tr><th>Nombre</th><th>País</th><th>Empresa</th><th class="text-center">Acción</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in detallesPasantias) {
                                <tr>
                                    <td>@p["nombre"]</td><td>@p["pais"]</td><td>@p["empresa"]</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => detallesPasantias.Remove(p)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <button class="btn btn-success btn-lg px-5 shadow" @onclick="GuardarTodo">GUARDAR TODO</button>
                    <button class="btn btn-secondary btn-lg" @onclick="() => mostrarFormulario = false">Cancelar</button>
                </div>
            </div>
        </div>
    } else {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <thead class="table-dark">
                    <tr><th>ID</th><th>Nombre</th><th>Ciudad</th><th class="text-center">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros) {
                        <tr>
                            <td>@reg["id"]</td><td class="fw-bold">@reg["nombre"]</td><td>@reg["ciudad"]</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> detallesPasantias = new();
    private bool mostrarFormulario = false, editando = false, exito = false;
    private string mensaje = "";

    private int campoId, campoFacultad;
    private string campoNombre = "", campoTipo = "", campoNivel = "", campoCiudad = "", campoNumCohortes = "0", campoCantGraduados = "0";
    private DateTime campoFechaCreacion = DateTime.Now, campoFechaActualizacion = DateTime.Now, campoFechaCierre = DateTime.Now;

    private string tmpPasNombre = "", tmpPasPais = "", tmpPasEmpresa = "", tmpPasDesc = "";

    protected override async Task OnInitializedAsync() => await CargarRegistros();
    private async Task CargarRegistros() => registros = await Api.ListarAsync("programa");

    private void AgregarPasLocal() {
        if (!string.IsNullOrEmpty(tmpPasNombre)) {
            detallesPasantias.Add(new Dictionary<string, object?> {
                ["id"] = 0, ["nombre"] = tmpPasNombre, ["pais"] = tmpPasPais, ["empresa"] = tmpPasEmpresa, ["descripcion"] = tmpPasDesc
            });
            tmpPasNombre = ""; tmpPasPais = ""; tmpPasEmpresa = ""; tmpPasDesc = "";
        }
    }

    private async Task GuardarTodo() {
        try {
            if (!editando) {
                var todosProg = await Api.ListarAsync("programa");
                campoId = todosProg.Any() ? todosProg.Max(x => Convert.ToInt32(x["id"])) + 1 : 1;
            }

            var objMaestro = new Dictionary<string, object?> {
                ["id"] = campoId, ["nombre"] = campoNombre, ["tipo"] = campoTipo, ["nivel"] = campoNivel,
                ["fecha_creacion"] = campoFechaCreacion.ToString("yyyy-MM-dd"), ["fecha_cierre"] = campoFechaCierre.ToString("yyyy-MM-dd"),
                ["numero_cohortes"] = campoNumCohortes, ["cant_graduados"] = campoCantGraduados,
                ["fecha_actualizacion"] = campoFechaActualizacion.ToString("yyyy-MM-dd"), ["ciudad"] = campoCiudad, ["facultad"] = campoFacultad
            };

            var res = editando ? await Api.ActualizarAsync("programa", "id", campoId.ToString(), objMaestro) : await Api.CrearAsync("programa", objMaestro);

            if (res.exito) {
                
                var todasPasDB = await Api.ListarAsync("pasantia");
                
                
                var pasantiasViejas = todasPasDB.Where(x => x["programa"]?.ToString() == campoId.ToString()).ToList();
                foreach (var pv in pasantiasViejas) {
                    await Api.EliminarAsync("pasantia", "id", pv["id"]?.ToString() ?? "");
                }

                
                int sigPasId = todasPasDB.Any() ? todasPasDB.Max(x => Convert.ToInt32(x["id"])) + 1 : 1;
                foreach (var p in detallesPasantias) {
                    p["id"] = sigPasId++; 
                    p["programa"] = campoId;
                    await Api.CrearAsync("pasantia", p);
                }

                mensaje = "Guardado con éxito"; exito = true; mostrarFormulario = false; await CargarRegistros();
            }
        } catch (Exception ex) { mensaje = "Error: " + ex.Message; exito = false; }
    }

    private void NuevoRegistro() {
        editando = false; campoId = 0; campoNombre = ""; detallesPasantias.Clear(); mostrarFormulario = true;
    }

    private async Task EditarRegistro(Dictionary<string, object?> reg) {
        editando = true;
        campoId = Convert.ToInt32(reg["id"]);
        campoNombre = reg["nombre"]?.ToString() ?? "";
        campoTipo = reg["tipo"]?.ToString() ?? "";
        campoNivel = reg["nivel"]?.ToString() ?? "";
        campoCiudad = reg["ciudad"]?.ToString() ?? "";
        campoFacultad = Convert.ToInt32(reg["facultad"]);
        campoNumCohortes = reg["numero_cohortes"]?.ToString() ?? "0";
        campoCantGraduados = reg["cant_graduados"]?.ToString() ?? "0";
        if(DateTime.TryParse(reg["fecha_creacion"]?.ToString(), out var fc)) campoFechaCreacion = fc;
        if(DateTime.TryParse(reg["fecha_cierre"]?.ToString(), out var fci)) campoFechaCierre = fci;
        if(DateTime.TryParse(reg["fecha_actualizacion"]?.ToString(), out var fa)) campoFechaActualizacion = fa;

        var pTodo = await Api.ListarAsync("pasantia");
        detallesPasantias = pTodo.Where(x => x["programa"]?.ToString() == campoId.ToString()).ToList();
        mostrarFormulario = true;
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg) {
        if (await JS.InvokeAsync<bool>("confirm", "¿Eliminar programa y sus pasantías?")) {
            
            var pTodo = await Api.ListarAsync("pasantia");
            var pasDel = pTodo.Where(x => x["programa"]?.ToString() == reg["id"]?.ToString()).ToList();
            foreach(var p in pasDel) await Api.EliminarAsync("pasantia", "id", p["id"]?.ToString() ?? "");

            await Api.EliminarAsync("programa", "id", reg["id"]?.ToString() ?? "");
            await CargarRegistros();
        }
    }
}