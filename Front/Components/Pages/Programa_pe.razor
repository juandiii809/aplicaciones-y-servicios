@page "/programa_pe"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services

<PageTitle>Prácticas y Estrategias por Programa</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Prácticas y Estrategias por Programa</h3>
        @if (!mostrarFormulario)
        {
            <button class="btn btn-primary shadow" @onclick="NuevoRegistro">
                <i class="bi bi-plus-circle"></i> Asignar Práctica/Estrategia
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (mostrarFormulario)
    {
        <div class="card shadow border-primary mb-5">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@(editando ? "Editando prácticas del programa: " + ObtenerNombrePrograma(campoProgramaId.ToString()) : "Nueva Asignación")</h5>
            </div>
            <div class="card-body">

                @* ── SELECCIÓN DE PROGRAMA ── *@
                <div class="row border-bottom pb-3 mb-4">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Programa</label>
                        <select class="form-select" @bind="campoProgramaId" disabled="@editando">
                            <option value="0">-- Seleccione un programa --</option>
                            @foreach (var p in programas)
                            {
                                <option value="@p["id"]">@p["nombre"]</option>
                            }
                        </select>
                    </div>
                </div>

                @* ── DETALLE PRACTICA_ESTRATEGIA ── *@
                <h5 class="text-secondary mb-3">Prácticas y Estrategias</h5>
                <div class="bg-light p-3 border rounded mb-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-10">
                            <select class="form-select" @bind="tmpPracticaId">
                                <option value="0">-- Seleccione una práctica/estrategia --</option>
                                @foreach (var pe in practicasEstrategias)
                                {
                                    @if (!detallesPracticas.Any(x => x["practica_estrategia"]?.ToString() == pe["id"]?.ToString()))
                                    {
                                        <option value="@pe["id"]">@pe["tipo"] — @pe["nombre"]</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-info w-100" @onclick="AgregarPracticaLocal">
                                <i class="bi bi-plus"></i> Agregar
                            </button>
                        </div>
                    </div>

                    <table class="table table-sm table-hover bg-white border">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Tipo</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pe in detallesPracticas)
                            {
                                <tr>
                                    <td>@pe["practica_estrategia"]</td>
                                    <td>@ObtenerCampoPractica(pe["practica_estrategia"]?.ToString(), "tipo")</td>
                                    <td>@ObtenerCampoPractica(pe["practica_estrategia"]?.ToString(), "nombre")</td>
                                    <td>@ObtenerCampoPractica(pe["practica_estrategia"]?.ToString(), "descripcion")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-danger"
                                                @onclick="() => detallesPracticas.Remove(pe)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!detallesPracticas.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No hay prácticas asignadas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <button class="btn btn-success btn-lg px-5 shadow" @onclick="GuardarTodo">
                        <i class="bi bi-save"></i> GUARDAR TODO
                    </button>
                    <button class="btn btn-secondary btn-lg ms-2" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (cargando)
        {
            <div class="d-flex justify-content-center my-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (programasConPe.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle border">
                    <thead class="table-dark">
                        <tr>
                            <th>ID Programa</th>
                            <th>Nombre Programa</th>
                            <th>Prácticas Asignadas</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grupo in programasConPe)
                        {
                            <tr>
                                <td>@grupo.Key</td>
                                <td class="fw-bold">@ObtenerNombrePrograma(grupo.Key.ToString())</td>
                                <td>
                                    @foreach (var pe in grupo.Value)
                                    {
                                        <span class="badge bg-primary me-1">
                                            @ObtenerCampoPractica(pe["practica_estrategia"]?.ToString(), "nombre")
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1"
                                            @onclick="() => EditarRegistro(grupo.Key)">
                                        Editar
                                    </button>
                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => EliminarPrograma(grupo.Key)">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning">No hay prácticas o estrategias asignadas a programas.</div>
        }
    }
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<Dictionary<string, object?>> programas = new();
    private List<Dictionary<string, object?>> practicasEstrategias = new();
    private List<Dictionary<string, object?>> todosRegistros = new();
    private Dictionary<int, List<Dictionary<string, object?>>> programasConPe = new();
    private List<Dictionary<string, object?>> detallesPracticas = new();

    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private bool exito = false;
    private string mensaje = "";

    private int campoProgramaId = 0;
    private int tmpPracticaId = 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarProgramas(), CargarPracticasEstrategias());
        await CargarRegistros();
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        todosRegistros = await Api.ListarAsync("programa_pe");

        programasConPe = todosRegistros
            .GroupBy(x => Convert.ToInt32(x["programa"]))
            .ToDictionary(g => g.Key, g => g.ToList());

        cargando = false;
    }

    private async Task CargarProgramas()
    {
        programas = await Api.ListarAsync("programa");
    }

    private async Task CargarPracticasEstrategias()
    {
        practicasEstrategias = await Api.ListarAsync("practica_estrategia");
    }

    private string ObtenerNombrePrograma(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "";
        var p = programas.FirstOrDefault(x => x["id"]?.ToString() == id);
        return p?["nombre"]?.ToString() ?? id;
    }

    private string ObtenerCampoPractica(string? id, string campo)
    {
        if (string.IsNullOrEmpty(id)) return "";
        var pe = practicasEstrategias.FirstOrDefault(x => x["id"]?.ToString() == id);
        return pe?[campo]?.ToString() ?? "";
    }

    private void AgregarPracticaLocal()
    {
        if (tmpPracticaId == 0) return;

        if (detallesPracticas.Any(x => x["practica_estrategia"]?.ToString() == tmpPracticaId.ToString()))
        {
            mensaje = "Esa práctica/estrategia ya está asignada.";
            exito = false;
            return;
        }

        detallesPracticas.Add(new Dictionary<string, object?>
        {
            ["practica_estrategia"] = tmpPracticaId,
            ["programa"] = campoProgramaId
        });

        tmpPracticaId = 0;
        mensaje = string.Empty;
    }

    private async Task GuardarTodo()
    {
        if (campoProgramaId == 0)
        {
            mensaje = "Debe seleccionar un programa.";
            exito = false;
            return;
        }

        if (!detallesPracticas.Any())
        {
            mensaje = "Debe agregar al menos una práctica o estrategia.";
            exito = false;
            return;
        }

        try
        {
            var viejos = todosRegistros
                .Where(x => x["programa"]?.ToString() == campoProgramaId.ToString())
                .ToList();

            foreach (var v in viejos)
                await Api.EliminarAsync("programa_pe", "programa", campoProgramaId.ToString());

            foreach (var pe in detallesPracticas)
            {
                var datos = new Dictionary<string, object?>
                {
                    ["practica_estrategia"] = pe["practica_estrategia"],
                    ["programa"] = campoProgramaId
                };
                await Api.CrearAsync("programa_pe", datos);
            }

            mensaje = "Guardado con éxito";
            exito = true;
            mostrarFormulario = false;
            await CargarRegistros();
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
            exito = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoProgramaId = 0;
        tmpPracticaId = 0;
        detallesPracticas.Clear();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task EditarRegistro(int programaId)
    {
        editando = true;
        campoProgramaId = programaId;
        tmpPracticaId = 0;

        detallesPracticas = todosRegistros
            .Where(x => x["programa"]?.ToString() == programaId.ToString())
            .ToList();

        mostrarFormulario = true;
        mensaje = string.Empty;
        await Task.CompletedTask;
    }

    private async Task EliminarPrograma(int programaId)
    {
        if (await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar todas las prácticas del programa {ObtenerNombrePrograma(programaId.ToString())}?"))
        {
            var aEliminar = todosRegistros
                .Where(x => x["programa"]?.ToString() == programaId.ToString())
                .ToList();

            foreach (var v in aEliminar)
                await Api.EliminarAsync("programa_pe", "programa", programaId.ToString());

            await CargarRegistros();
            mensaje = "Eliminado con éxito";
            exito = true;
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
        detallesPracticas.Clear();
    }
}