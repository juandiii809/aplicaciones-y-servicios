@page "/facultad"
@rendermode InteractiveServer
@using FrontBlazor_AppiGenericaCsharp.Services
@inject ApiService Api
@inject IJSRuntime JS

<PageTitle>Facultades</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Facultades</h3>

    @* ───────── ALERTA ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTONES Y FILTROS ───────── *@
    <div class="row mb-3">
        <div class="col-md-6">
            @if (!mostrarFormulario)
            {
                <button class="btn btn-primary" @onclick="NuevoRegistro">Nueva Facultad</button>
            }
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <label class="form-label me-2 mb-0">Límite:</label>
            <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
            <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
        </div>
    </div>

    @* ───────── FORMULARIO ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3 border-primary">
            <div class="card-header bg-primary text-white">
                @(editando ? "Editar Facultad" : "Nueva Facultad")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">ID</label>
                        <input class="form-control" type="number" @bind="campoId" disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="campoNombre" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo</label>
                        <input class="form-control" @bind="campoTipo" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de Fundación</label>
                        <input class="form-control" type="date" @bind="campoFechaFun" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Universidad</label>
                        <select class="form-select" @bind="campoUniversidad">
                            <option value="0">-- Seleccione Universidad --</option>
                            @foreach (var u in universidades)
                            {
                                <option value="@u["id"]">@u["nombre"] (ID: @u["id"])</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-2">
                    <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @* ───────── CONTENIDO PRINCIPAL ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (registros.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Fundación</th>
                        <th>Universidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@reg["id"]</td>
                            <td>@reg["nombre"]</td>
                            <td>@reg["tipo"]</td>
                            <td>@(DateTime.TryParse(reg["fecha_fun"]?.ToString(), out var f) ? f.ToShortDateString() : reg["fecha_fun"])</td>
                            <td>@ObtenerNombreUniversidad(reg["universidad"]?.ToString())</td>
                            <td>
                                <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No se encontraron facultades registradas.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> universidades = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos del formulario
    private int campoId = 0;
    private string campoNombre = string.Empty;
    private string campoTipo = string.Empty;
    private DateTime campoFechaFun = DateTime.Now;
    private int campoUniversidad = 0;
    private int? limite = null;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            universidades = await Api.ListarAsync("universidad");
            await CargarRegistros();
        }
        catch (Exception ex)
        {
            mensaje = "Error al conectar con la API: " + ex.Message;
            exito = false;
            cargando = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        try 
        {
            registros = await Api.ListarAsync("facultad", limite);
        }
        finally 
        {
            cargando = false;
        }
    }

    private string ObtenerNombreUniversidad(string? id)
    {
        if (string.IsNullOrEmpty(id) || id == "0") return "N/A";
        var uni = universidades.FirstOrDefault(u => u["id"]?.ToString() == id);
        return uni?["nombre"]?.ToString() ?? $"ID: {id}";
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoId = 0;
        campoNombre = string.Empty;
        campoTipo = string.Empty;
        campoFechaFun = DateTime.Now;
        campoUniversidad = 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoId = int.TryParse(reg["id"]?.ToString(), out int id) ? id : 0;
        campoNombre = reg["nombre"]?.ToString() ?? "";
        campoTipo = reg["tipo"]?.ToString() ?? "";
        campoFechaFun = DateTime.TryParse(reg["fecha_fun"]?.ToString(), out DateTime fecha) ? fecha : DateTime.Now;
        campoUniversidad = int.TryParse(reg["universidad"]?.ToString(), out int uni) ? uni : 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["id"] = campoId,
            ["nombre"] = campoNombre,
            ["tipo"] = campoTipo,
            ["fecha_fun"] = campoFechaFun.ToString("yyyy-MM-dd"),
            ["universidad"] = campoUniversidad
        };

        if (editando)
        {
            var confirmar = await JS.InvokeAsync<bool>("confirm", $"¿Actualizar Facultad {campoId}?");
            if (!confirmar) return;
            
            var datosUpdate = new Dictionary<string, object?>(datos);
            datosUpdate.Remove("id");

            var resultado = await Api.ActualizarAsync("facultad", "id", campoId.ToString(), datosUpdate);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("facultad", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            mostrarFormulario = false;
            await CargarRegistros();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["id"]?.ToString() ?? "";
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar Facultad {id}?");
        if (!confirmar) return;
        
        var resultado = await Api.EliminarAsync("facultad", "id", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito) await CargarRegistros();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}