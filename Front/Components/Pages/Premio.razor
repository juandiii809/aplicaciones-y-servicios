@page "/Premio"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Premio</PageTitle>

<div class="container mt-4">
    <h3>Premio</h3>

    @* ───────── ALERTA ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTON NUEVO ───────── *@
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Premio</button>
    }

    @* ───────── LIMITE DE REGISTROS ───────── *@
    <div class="d-flex align-items-center mb-3">
        <label class="form-label me-2 mb-0">Límite:</label>
        <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
        <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
    </div>

    @* ───────── FORMULARIO ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Premio" : "Nuevo Premio")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">id</label>
                        <input class="form-control" @bind="campoid" disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">nombre</label>
                        <input class="form-control" @bind="camponombre" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">descripcion</label>
                        <input class="form-control" @bind="campodescripcion" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">fecha</label>
                        <input class="form-control" type="date" @bind="campofecha" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">entidad otorgante</label>
                        <input class="form-control" @bind="campoentidad_otorgante" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">pais</label>
                        <input class="form-control" @bind="campopais" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">programa</label>
                        <select class="form-select" @bind="campoprograma">
                            <option value="">-- Seleccione un programa --</option>
                            @foreach (var p in programas)
                            {
                                <option value="@p["id"]">@p["nombre"]</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @* ───────── SPINNER ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @* ───────── TABLA ───────── *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>id</th>
                    <th>nombre</th>
                    <th>descripcion</th>
                    <th>fecha</th>
                    <th>entidad otorgante</th>
                    <th>pais</th>
                    <th>programa</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["id"]</td>
                        <td>@reg["nombre"]</td>
                        <td>@reg["descripcion"]</td>
                        <td>@reg["fecha"]</td>
                        <td>@reg["entidad_otorgante"]</td>
                        <td>@reg["pais"]</td>
                        <td>@ObtenerNombrePrograma(reg["programa"]?.ToString())</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros en la tabla Premio.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> programas = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos del formulario
    private string campoid = string.Empty;
    private string camponombre = string.Empty;
    private string campodescripcion = string.Empty;
    private DateTime? campofecha = null;
    private string campoentidad_otorgante = string.Empty;
    private string campopais = string.Empty;
    private string campoprograma = string.Empty;
    private int? limite = null;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarRegistros(), CargarProgramas());
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("premio", limite);
        cargando = false;
    }

    private async Task CargarProgramas()
    {
        programas = await Api.ListarAsync("programa", null);
    }

    private string ObtenerNombrePrograma(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "";
        var p = programas.FirstOrDefault(x => x["id"]?.ToString() == id);
        return p?["nombre"]?.ToString() ?? id;
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoid = string.Empty;
        camponombre = string.Empty;
        campodescripcion = string.Empty;
        campofecha = null;
        campoentidad_otorgante = string.Empty;
        campopais = string.Empty;
        campoprograma = string.Empty;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoid = reg["id"]?.ToString() ?? "";
        camponombre = reg["nombre"]?.ToString() ?? "";
        campodescripcion = reg["descripcion"]?.ToString() ?? "";
        campofecha = DateTime.TryParse(reg["fecha"]?.ToString(), out var f) ? f : null;
        campoentidad_otorgante = reg["entidad_otorgante"]?.ToString() ?? "";
        campopais = reg["pais"]?.ToString() ?? "";
        campoprograma = reg["programa"]?.ToString() ?? "";
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["id"] = campoid,
            ["nombre"] = camponombre,
            ["descripcion"] = campodescripcion,
            ["fecha"] = campofecha?.ToString("yyyy-MM-dd"),
            ["entidad_otorgante"] = campoentidad_otorgante,
            ["pais"] = campopais,
            ["programa"] = campoprograma
        };

        if (editando)
        {
            datos.Remove("id");
            var resultado = await Api.ActualizarAsync("premio", "id", campoid, datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("premio", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            mostrarFormulario = false;
            await CargarRegistros();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["id"]?.ToString() ?? "";
        var resultado = await Api.EliminarAsync("premio", "id", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito)
            await CargarRegistros();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}